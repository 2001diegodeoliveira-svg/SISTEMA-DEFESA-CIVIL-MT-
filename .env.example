# Backend SGI PROTEGE — variáveis de ambiente

# Segredo para assinatura dos tokens JWT (obrigatório; mínimo 32 bytes em produção)
JWT_SECRET=

# Validade do token (padrão 12h)
JWT_EXP=12h

# Bootstrap de administrador (única exceção ao cadastro aprovado). Defina fora do repositório
# com senha aleatória de pelo menos 10 caracteres. Usuários comuns entram pelo cadastro público.
# SEED_USERS=[{"usuario":"admin-inicial","senha":"SUBSTITUA-POR-SEGREDO-ALEATORIO","nome":"Administrador","perfil":"admin","municipio":"Cuiabá"}]
# Perfis válidos: comum, avancado, admin, municipal
SEED_USERS=

# MFA (TOTP): 32 bytes em hexadecimal (64 caracteres 0-9/a-f).
# Obrigatória em produção quando AUTH_LOGIN_ENABLED está ligado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca commite o valor real — configure no .env.producao ou no painel do deploy.
MFA_ENCRYPTION_KEY=

# CORS: use origens HTTPS explícitas em produção, separadas por vírgula.
CORS_ORIGIN=*

# Hosts externos usados pelo proxy. Obrigatório em produção; nunca use *.
PROXY_HOSTS=apiprevmet3.inmet.gov.br,apitempo.inmet.gov.br,panorama.sipam.gov.br,dataserver-coids.inpe.br,api.open-meteo.com,api.rainviewer.com,nominatim.openstreetmap.org,overpass-api.de,brasilapi.com.br,assets.msn.com,obrasaovivo.sinfra.mt.gov.br,ibge.gov.br

# Persistência
#  - Local/servidor próprio: use FILE_STORE=1 (default) → arquivos em ./data
#  - Vercel: configure KV_REST_API_URL e KV_REST_API_TOKEN (Upstash KV) p/ persistir
#  - PostgreSQL (Neon): defina DATABASE_URL e FILE_STORE=0 para usar o driver 'pg'
FILE_STORE=1
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PostgreSQL (Neon) — string de conexão do Painel Neon → Connect.
# Aplicar schema + migrar os JSONs de ./data:  npm run db:migrate
# Só o DDL (sem migrar dados):                 node db/migrate.js --schema-only
DATABASE_URL=

# Porta do servidor local (padrão 3000)
PORT=3000

# --- Alerta de pluviômetro (30% do limite) ---
# Limite absoluto de chuva em 24h, em mm. O alerta dispara quando o
# acumulado 24h de uma estação atinge PLUV_ALERTA_PERCENTUAL% deste valor.
# Faixa aceita: 1 a 1000.
PLUV_ALERTA_LIMITE_MM=100

# Percentual do limite que dispara o popup. Faixa: 1 a 100.
PLUV_ALERTA_PERCENTUAL=30

# Liga/desliga o alerta no servidor. Com off (ou 0/false), a API
# devolve "acima" vazio e o mapa não abre popup, mesmo com o
# pluviômetro acima do limiar. Aceita: 1/0, true/false, on/off.
PLUV_ALERTA_ATIVO=1

# Integrações de trânsito desativadas por padrão; ative apenas para testes
# simulados ou quando houver credenciais oficiais configuradas.
WAZE_ENABLED=0
WAZE_MOCK_ENABLED=0
TOMTOM_ENABLED=0
TOMTOM_MOCK_ENABLED=0


# Autenticacao desligada: acesso anonimo, inclusive a operacoes administrativas.
AUTH_LOGIN_ENABLED=false
AUTH_SEED_ONLY=false
DEMO_HORAS=24

# --- Módulo ENOS / El Niño (Fase 1; ver docs/enso.md) ---
# Limiares de classificação em °C (simétricos p/ La Niña).
# Neutro: |anomalia| < banda. Nunca fixos no código: store > env > padrão.
ENSO_NEUTRO_BANDA=0.5
ENSO_FRACO=0.5
ENSO_MODERADO=1.0
ENSO_FORTE=1.5
ENSO_MUITO_FORTE=2.0

# Histerese (°C) e janela de deduplicação (horas) das regras.
ENSO_HISTERESE=0.1
ENSO_REAVISO_HORAS=24

# Regras declarativas (JSON). Vazio = 4 regras padrão
# (OBSERVACAO 0.5, ATENCAO 1.0, ALERTA 1.5, EMERGENCIA 2.0).
# ENSO_RULES_JSON=[{"id":"enso-alerta","nivel":"ALERTA","descricao":"...","condicao":{"indice":"ONI","operador":">=","limiarAbs":1.5},"exigeConfirmacao":true,"canais":["email","webhook"]}]
ENSO_RULES_JSON=

# Dry-run LIGADO por padrão: nenhum envio real. Para envios reais,
# configure ENSO_WEBHOOK_URL e desligue o dry-run (produção).
ENSO_DRY_RUN=1
ENSO_WEBHOOK_URL=
ENSO_EMAIL_DESTINO=

# Coletor NOAA/CPC: URLs verificadas ao vivo em 2026-10-11
# (oni.ascii.txt: linhas "SEAS YR TOTAL ANOM"; sstoi.indices: regiões
# Niño 1+2/3/4/3.4 mensais). Podem ser sobrescritas; esvaziar volta
# ao padrão verificado. ENSO_NOAA_ENABLED=0 desliga o coletor real.
ENSO_NOAA_ENABLED=1
ENSO_NOAA_ONI_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
ENSO_NOAA_SST_URL=https://www.cpc.ncep.noaa.gov/data/indices/sstoi.indices
ENSO_FONTE_STALE_HORAS=72

# Links oficiais exibidos na UI (JSON). Vazio = 6 padrões
# (INMET, CPTEC/INPE, CEMADEN, ANA/SNIRH, INPE Queimadas, NOAA/CPC).
ENSO_FONTES_JSON=
