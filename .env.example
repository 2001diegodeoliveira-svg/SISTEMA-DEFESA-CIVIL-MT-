# Backend SGI PROTEGE MT — variáveis de ambiente

# Segredo para assinatura dos tokens JWT (obrigatório; mínimo 32 bytes em produção)
JWT_SECRET=

# Validade do token (padrão 12h)
JWT_EXP=12h

# Bootstrap de administrador (única exceção ao cadastro aprovado). Defina fora do repositório
# com senha aleatória de pelo menos 12 caracteres. Usuários comuns entram pelo cadastro público.
# SEED_USERS=[{"usuario":"admin-inicial","senha":"SUBSTITUA-POR-SEGREDO-ALEATORIO","nome":"Administrador","perfil":"admin","municipio":"Cuiabá"}]
# Perfis válidos: comum, avancado, admin, municipal
SEED_USERS=

# CORS: use origens HTTPS explícitas em produção, separadas por vírgula.
CORS_ORIGIN=*

# Hosts externos usados pelo proxy. Obrigatório em produção; nunca use *.
PROXY_HOSTS=apiprevmet3.inmet.gov.br,apitempo.inmet.gov.br,panorama.sipam.gov.br,dataserver-coids.inpe.br,api.open-meteo.com,api.rainviewer.com,nominatim.openstreetmap.org,overpass-api.de,brasilapi.com.br,assets.msn.com,obrasaovivo.sinfra.mt.gov.br,ibge.gov.br

# Persistência
#  - Local/servidor próprio: use FILE_STORE=1 (default) → arquivos em ./data
#  - Vercel: configure KV_REST_API_URL e KV_REST_API_TOKEN (Upstash KV) p/ persistir
#  - PostgreSQL (Neon): defina DATABASE_URL e FILE_STORE=0 para usar o driver 'pg'
FILE_STORE=1
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PostgreSQL (Neon) — string de conexão do Painel Neon → Connect.
# Aplicar schema + migrar os JSONs de ./data:  npm run db:migrate
# Só o DDL (sem migrar dados):                 node db/migrate.js --schema-only
DATABASE_URL=

# Porta do servidor local (padrão 3000)
PORT=3000

# --- Alerta de pluviômetro (30% do limite) ---
# Limite absoluto de chuva em 24h, em mm. O alerta dispara quando o
# acumulado 24h de uma estação atinge PLUV_ALERTA_PERCENTUAL% deste valor.
# Faixa aceita: 1 a 1000.
PLUV_ALERTA_LIMITE_MM=100

# Percentual do limite que dispara o popup. Faixa: 1 a 100.
PLUV_ALERTA_PERCENTUAL=30

# Liga/desliga o alerta no servidor. Com off (ou 0/false), a API
# devolve "acima" vazio e o mapa não abre popup, mesmo com o
# pluviômetro acima do limiar. Aceita: 1/0, true/false, on/off.
PLUV_ALERTA_ATIVO=1

# Integrações de trânsito desativadas por padrão; ative apenas para testes
# simulados ou quando houver credenciais oficiais configuradas.
WAZE_ENABLED=0
WAZE_MOCK_ENABLED=0
TOMTOM_ENABLED=0
TOMTOM_MOCK_ENABLED=0


# Autenticacao e janela de demonstracao
AUTH_LOGIN_ENABLED=true
DEMO_HORAS=24
