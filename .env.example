# Backend Defesa Civil MT — variáveis de ambiente

# Segredo para assinatura dos tokens JWT (OBRIGATÓRIO em produção)
JWT_SECRET=troque-por-um-segredo-forte

# Validade do token (padrão 12h)
JWT_EXP=12h

# Usuários iniciais em formato JSON. Exemplo:
# SEED_USERS=[{"usuario":"diego","senha":"senha","nome":"Diego","perfil":"admin","municipio":"Cuiabá"}]
# Perfis válidos: comum, avancado, admin, municipal
SEED_USERS=

# CORS: origem permitida. Padrão * (qualquer). Em produção use o domínio do site.
CORS_ORIGIN=*

# Persistência
#  - Local/servidor próprio: use FILE_STORE=1 (default) → arquivos em ./data
#  - Vercel: configure KV_REST_API_URL e KV_REST_API_TOKEN (Upstash KV) p/ persistir
FILE_STORE=1
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Porta do servidor local (padrão 3000)
PORT=3000
