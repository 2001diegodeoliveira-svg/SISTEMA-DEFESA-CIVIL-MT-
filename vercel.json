{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/fontes/vigilancia",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/enso/cron",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}